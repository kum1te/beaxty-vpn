# ====================================================================
# Beaxty VPN - .gitignore
# ====================================================================

# Build artifacts and build directories
build/
build-local/
cmake-build-*/
out/
bin/
dist/
AppDir/
*.AppImage
*.tar.gz
*.zip
*.dmg
*.exe
*.o
*.a
*.so
*.dylib

# Cache and temporary directories
.cache/
.tempmediaStorage/

# Database, SQLite & storage files
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
cache.db
throne.db
*.lock

# Logs and crash dumps
*.log
*.debug
*.core
*.dmp
dump/

# Media, test captures and screenshots (root only)
/*.png
/*.jpg
/*.jpeg
/beaxty_*.png
bganim.mp4

# Allow all application and 3rdparty resource assets
!res/**
!3rdparty/**/res/**

# Developer environments & IDE configurations
.vscode/
.idea/
.qtcreator/
.claude/
.codex/
.gemini/
*.user
*.user.*
*.swp
*~
CMakeUserPresets.json

# Operating System temporary files
.DS_Store
Thumbs.db
desktop.ini
